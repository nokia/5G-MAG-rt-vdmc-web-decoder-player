+static void
+flipDecodedTexturesVertically(vmesh::Sequence& reconstruct) {
+  for (auto& attribute : reconstruct.attributes()) {
+    for (int32_t frameIdx = 0; frameIdx < attribute.frameCount(); ++frameIdx) {
+      auto& frame = attribute.frame(frameIdx);
+      for (int32_t planeIdx = 0; planeIdx < frame.planeCount(); ++planeIdx) {
+        auto& plane = frame.plane(planeIdx);
+        const int32_t h = plane.height();
+        const int32_t w = plane.width();
+        for (int32_t y = 0; y < (h >> 1); ++y) {
+          const int32_t yOpp = h - 1 - y;
+          for (int32_t x = 0; x < w; ++x) {
+            const auto tmp = plane(y, x);
+            plane(y, x)    = plane(yOpp, x);
+            plane(yOpp, x) = tmp;
+          }
+        }
+      }
+    }
+  }
+}
+
+static void
+mirrorDecodedUvsHorizontally(vmesh::Sequence& reconstruct) {
+  for (auto& mesh : reconstruct.meshes()) {
+    const auto texCoordCount = mesh.texCoordCount();
+    for (int32_t i = 0; i < texCoordCount; ++i) {
+      auto uv = mesh.texCoord(i);
+      uv[0] = 1.0 - uv[0];
+      mesh.setTexCoord(i, uv);
+    }
+  }
+}
+
+static void
+applyDecodedUvTransform(vmesh::Sequence& reconstruct, int32_t transformMode) {
+  for (auto& mesh : reconstruct.meshes()) {
+    const auto texCoordCount = mesh.texCoordCount();
+    for (int32_t i = 0; i < texCoordCount; ++i) {
+      auto uv = mesh.texCoord(i);
+      switch (transformMode) {
+      case 1: uv[0] = 1.0 - uv[0]; break;                    // mirror U
+      case 2: uv[1] = 1.0 - uv[1]; break;                    // mirror V
+      case 3:
+        uv[0] = 1.0 - uv[0];
+        uv[1] = 1.0 - uv[1];
+        break;                                               // mirror UV
+      default: break;                                        // none
+      }
+      mesh.setTexCoord(i, uv);
+    }
+  }
+}
