diff --git a/source/wrapper/videoDecoder/webVideoDecoderImpl.cpp b/source/wrapper/videoDecoder/webVideoDecoderImpl.cpp
new file mode 100644
index 00000000..7a24950e
--- /dev/null
+++ b/source/wrapper/videoDecoder/webVideoDecoderImpl.cpp
@@ -0,0 +1,151 @@
+#if defined(USE_WEB_VIDEO_DECODER)
+
+#    include "webVideoDecoderImpl.hpp"
+
+#    include <cstdio>
+#    include <cstring>
+#    include <sstream>
+
+#    ifdef __EMSCRIPTEN__
+#    include <emscripten.h>
+#    include <emscripten/bind.h>
+#    endif
+
+namespace vmesh {
+
+template <typename T>
+webVideoDecoderImpl<T>::webVideoDecoderImpl() = default;
+
+template <typename T>
+webVideoDecoderImpl<T>::~webVideoDecoderImpl() = default;
+
+template <typename T>
+void
+webVideoDecoderImpl<T>::decode(const std::vector<uint8_t>& bitstream,
+                               FrameSequence<T>&           video,
+                               std::vector<size_t>&        videoBitDepth,
+                               size_t                      layerIdx,
+                               const std::string&          decoderPath,
+                               const std::string&          parameters) {
+#    ifdef __EMSCRIPTEN__
+  // WASM Option B: video decode is handled in JS via WebCodecs.
+  // Raw HEVC bytes are forwarded from decoder.cpp via Module.enqueueVideo(),
+  // so the C++ video decoder path is bypassed entirely here.
+  printf("[WebDecoder] WASM mode ΓÇö video decode bypassed (handled by JS WebCodecs)\n");
+  fflush(stdout);
+  return;
+#    else
+  size_t width = 0, height = 0, bitDepth = 10, frameCount = 0;
+
+  // Parse bitstream or use parameters to determine dimensions
+  if (bitstream.empty()) {
+    printf("[WebDecoder] Empty bitstream ΓÇö skipping\n");
+    fflush(stdout);
+    return;
+  }
+
+  parseBitstreamInfo(bitstream, width, height, bitDepth, frameCount);
+
+  // If we couldn't parse, fall back to parameter defaults
+  if (frameCount == 0) frameCount = 1;
+  if (width == 0) width = 512;  // common V-DMC default
+  if (height == 0) height = 512;
+
+  printf("[WebDecoder] Decoding %zu frames: %dx%d, bitDepth=%zu\n",
+         frameCount, width, height, bitDepth);
+  fflush(stdout);
+
+  // Allocate output FrameSequence
+  video.resize(static_cast<int>(width), static_cast<int>(height),
+               ColourSpace::YUV420p, static_cast<int>(frameCount), 512);
+
+  // Fill videoBitDepth
+  videoBitDepth.resize(frameCount > 0 ? frameCount : 1, bitDepth);
+
+  // Non-WASM fallback: create placeholder frames
+  printf("[WebDecoder] Running in non-WASM mode ΓÇö writing placeholder frames\n");
+  for (size_t f = 0; f < frameCount; f++) {
+    auto& frame = video.frame(static_cast<int>(f));
+    // Fill Y plane with mid-gray (128 for 8-bit, 512 for 10-bit)
+    const T midGray = static_cast<T>((1 << (bitDepth - 1)));
+    for (size_t plane = 0; plane < 3; plane++) {
+      for (size_t i = 0; i < frame.plane(plane).size(); i++) {
+        frame.plane(plane).set(0, 0, plane, plane == 0 ? midGray : midGray / 2);
+      }
+    }
+  }
+#    endif
+}
+
+template <typename T>
+void
+webVideoDecoderImpl<T>::parseBitstreamInfo(const std::vector<uint8_t>& bitstream,
+                                           size_t& width,
+                                           size_t& height,
+                                           size_t& bitDepth,
+                                           size_t& frameCount) {
+  // Attempt to parse minimal info from AV1/VP9 bitstream container.
+  // This is a simplified parser ΓÇö full parsing requires AV1/VP9 Annex-B parser.
+  // For now, we rely on the bitstream size to estimate frame count if width/height unknown.
+
+  if (bitstream.size() < 8) {
+    return;  // Too small to be valid
+  }
+
+  // Look for AV1 config sequence byte (first byte of AV1 Coded Sequence)
+  // In Annex-B format, look for start codes (0x00 0x00 0x00 0x01)
+  for (size_t i = 0; i + 4 < bitstream.size(); i++) {
+    if (bitstream[i] == 0x00 && bitstream[i + 1] == 0x00
+        && bitstream[i + 2] == 0x00 && bitstream[i + 3] == 0x01) {
+      if (i + 5 < bitstream.size()) {
+        uint8_t firstByte = bitstream[i + 4];
+        uint8_t forbiddenBit = (firstByte >> 7) & 0x01;
+        uint8_t olr = (firstByte >> 4) & 0x07;  // Output Level Restriction
+
+        if (forbiddenBit == 0) {
+          // Map output level to approximate width/height
+          // Level 0: up to 256x144, Level 1: up to 352x288, etc.
+          // This is a rough heuristic
+          static const uint32_t levels[][2] = {
+              {256, 144},   // Level 0
+              {352, 288},   // Level 1
+              {640, 360},   // Level 2
+              {640, 480},   // Level 3
+              {1280, 720},  // Level 4
+              {1920, 1080}, // Level 5
+              {2048, 1152}, // Level 5b
+              {4096, 2304}  // Level 6
+          };
+          if (olr < sizeof(levels) / sizeof(levels[0])) {
+            width  = levels[olr][0];
+            height = levels[olr][1];
+          }
+        }
+        break;
+      }
+    }
+  }
+
+  // Estimate frame count from bitstream size (rough heuristic for known dimensions)
+  if (width > 0 && height > 0) {
+    const double bytesPerFrame = width * height * 3.0 / 8.0 * 0.5;  // YUV420, ~0.5 bpp avg
+    frameCount = static_cast<size_t>(bitstream.size() / bytesPerFrame);
+  }
+
+  bitDepth = 10;  // V-DMC default
+}
+
+template <typename T>
+std::string
+webVideoDecoderImpl<T>::buildCodecConfig(const std::string& parameters) const {
+  // Parse parameters string for width/height hints
+  // Default to HEVC Main10 (matches V-DMC texture/displacement streams and the JS SDK)
+  return "hvc1.2.4.L153.B0";
+}
+
+template class webVideoDecoderImpl<uint8_t>;
+template class webVideoDecoderImpl<uint16_t>;
+
+}  // namespace vmesh
+
+#endif
